# ---------------------------------------------------------------------------
# yieldloop environment. Copy to .env and fill in. Every value below is read by
# src/yieldloop/config.py; there are no tunable constants hardcoded in modules.
# ---------------------------------------------------------------------------

YIELDLOOP_ENV=local
YIELDLOOP_LOG_LEVEL=INFO
YIELDLOOP_LOG_FORMAT=json

# --- Database --------------------------------------------------------------
YIELDLOOP_DATABASE_URL=postgresql+psycopg://yieldloop:yieldloop@localhost:5432/yieldloop
YIELDLOOP_DB_POOL_SIZE=10
YIELDLOOP_DB_POOL_MAX_OVERFLOW=5
YIELDLOOP_DB_STATEMENT_TIMEOUT_MS=15000

# --- Dataset ---------------------------------------------------------------
# WM811K is downloaded by scripts/fetch_dataset.py via the Kaggle API.
# Requires ~/.kaggle/kaggle.json (Kaggle -> Account -> Create New API Token).
YIELDLOOP_DATA_DIR=./data
YIELDLOOP_KAGGLE_DATASET=qingyi/wm811k-wafer-map
YIELDLOOP_WM811K_FILENAME=LSWMD.pkl
# sha256 of the extracted LSWMD.pkl, recorded on first successful fetch and
# thereafter verified on every load. Leave blank to record it.
YIELDLOOP_WM811K_SHA256=

# --- Ingest / partitioning -------------------------------------------------
YIELDLOOP_GRID_HEIGHT=64
YIELDLOOP_GRID_WIDTH=64
YIELDLOOP_PARTITION_SEED=20260913
YIELDLOOP_PARTITION_TRAIN_FRACTION=0.70
YIELDLOOP_PARTITION_VAL_FRACTION=0.15
# holdout fraction is 1 - train - val
YIELDLOOP_LOT_RETENTION_DAYS=365

# --- Model registry --------------------------------------------------------
YIELDLOOP_REGISTRY_DIR=./data/registry
YIELDLOOP_TRAIN_SEED=20260913
YIELDLOOP_EMBEDDING_DIM=128

# --- Routing bands (swept by the eval harness; never hardcoded) -------------
# Above auto_commit: committed without a human. Inside the band: routed to a
# human with the prediction shown. Below confidence_floor: routed to a human
# with the prediction hidden, to avoid anchoring the reviewer.
YIELDLOOP_AUTO_COMMIT_THRESHOLD=0.95
YIELDLOOP_CONFIDENCE_FLOOR=0.55

# --- Active learning -------------------------------------------------------
YIELDLOOP_ROUND_BATCH_SIZE=64
YIELDLOOP_DIVERSITY_WEIGHT=0.5
YIELDLOOP_DIVERSITY_MIN_DISTANCE=0.10

# --- Retrieval -------------------------------------------------------------
YIELDLOOP_FAISS_INDEX_PATH=./data/registry/wafer.index
YIELDLOOP_RETRIEVAL_TOP_K=8

# --- Agent -----------------------------------------------------------------
OPENAI_API_KEY=
YIELDLOOP_OPENAI_MODEL=gpt-4o-2024-08-06
YIELDLOOP_AGENT_TIMEOUT_SECONDS=30
YIELDLOOP_AGENT_MAX_HYPOTHESES=3

# --- Guardrails: budget ----------------------------------------------------
YIELDLOOP_MAX_PROMPT_TOKENS=12000
YIELDLOOP_MAX_COMPLETION_TOKENS=2000
YIELDLOOP_SESSION_COST_CAP_USD=1.00
YIELDLOOP_DAILY_COST_CAP_USD=25.00
YIELDLOOP_INPUT_COST_PER_MTOK_USD=2.50
YIELDLOOP_OUTPUT_COST_PER_MTOK_USD=10.00

# --- Guardrails: input filter ---------------------------------------------
YIELDLOOP_MAX_FREE_TEXT_CHARS=2000

# --- Guardrails: circuit breaker ------------------------------------------
YIELDLOOP_BREAKER_SCHEMA_FAILURE_STREAK=3
YIELDLOOP_BREAKER_GROUNDING_REJECT_RATIO=0.30
YIELDLOOP_BREAKER_LATENCY_P95_SECONDS=20.0
YIELDLOOP_BREAKER_WINDOW_SIZE=20
YIELDLOOP_BREAKER_COOLDOWN_SECONDS=300

# --- API -------------------------------------------------------------------
YIELDLOOP_API_HOST=0.0.0.0
YIELDLOOP_API_PORT=8000
YIELDLOOP_CORS_ORIGINS=http://localhost:5173
