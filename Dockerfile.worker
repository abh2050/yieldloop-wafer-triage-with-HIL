FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpq5 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --upgrade pip && pip install .

COPY scripts ./scripts
COPY eval ./eval

# The worker runs training, embedding, index builds, and telemetry rollups.
# It is driven by scripts/, so the default command is a no-op shell that keeps
# the container available for `docker compose run worker <script>`.
CMD ["python", "-m", "yieldloop.telemetry.metrics"]
